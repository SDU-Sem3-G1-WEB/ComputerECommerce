@page
@model ComputerECommerce.Pages.ShoppingCartModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container mt-5">
    <div class="row">
        <div class="col">
            <h2 class="mb-4">Shopping Cart</h2>
            <table class="table table-hover table-responsive-md align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Image</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>Total</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ShoppingCartItems)
                    {
                        <tr>
                            <td class="text-start">@item.Product!.Name</td>
                            <td>
                                <img src="@item.Product.Image" alt="@item.Product.Name" class="img-thumbnail" style="max-width: 80px;">
                            </td>
                            <td>
                                <span class="fw-bold">@item.Quantity</span>
                            </td>
                            <td>@item.Product.Price.ToString("C")</td>
                            <td>@((item.Product.Price * item.Quantity).ToString("C"))</td>
                            <td>
                                <div class="btn-group">
                                     <form method="post" asp-page-handler="Remove" asp-route-id="@item.Product.Id" class="d-inline" style="margin-right: 5px;">
                                        <button type="submit" class="btn btn-lg btn-outline-danger">
                                            <i class="bi bi-dash-lg"></i> -1
                                        </button>
                                    </form>
                                    @if(item.Quantity < item.Product.Quantity)
                                    {
                                        <form method="post" asp-page-handler="Add" asp-route-id="@item.Product.Id" class="d-inline">
                                            <button type="submit" class="btn btn-lg btn-outline-primary">
                                                <i class="bi bi-plus-lg"></i> +1
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="text-end">
        <form method="post" asp-page-handler="Checkout">
            <button type="submit" class="btn btn-success btn-lg">Checkout</button>
        </form>
    </div>
</div>